# PostgreSQL
POSTGRES_DB=hbntory
POSTGRES_USER=hbntory_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5432

# Backoffice
DATABASE_URL=postgresql://hbntory_user:your_database_password@database:5432/hbntory

# Doit contenir au minimum 32 caractères.
# Génération conseillée :
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_32_CHARACTERS_MINIMUM

SESSION_COOKIE_SECURE=false

# Option locale lorsque pytest est lancé depuis l'hôte.
# La commande Docker documentée utilise automatiquement un PostgreSQL 16
# éphémère nommé hbntory_test via docker-compose.test.yml.
TEST_DATABASE_URL=postgresql://hbntory_user:your_database_password@localhost:5432/hbntory_test

# External Product API
PRODUCT_API_BASE_URL=http://external-products-api:5000
PRODUCT_API_PORT=5001

# Internal service communication
BACKOFFICE_INTERNAL_URL=http://backoffice:5000
MCP_SERVER_URL=http://product-mcp-server:8000/mcp
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_MAX_CONCURRENT_CALLS=10
MCP_RECONNECT_ATTEMPTS=3
MCP_RECONNECT_INITIAL_DELAY_SECONDS=0.25
MCP_RECONNECT_MAX_DELAY_SECONDS=2
# Un seul fournisseur est sélectionné au démarrage :
# NVIDIA si sa clé existe, sinon Ollama en mode hybrid.
AI_MODEL_PROVIDER=hybrid
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3
NVIDIA_REQUEST_TIMEOUT_SECONDS=120
NVIDIA_CLASSIFICATION_MAX_TOKENS=600
NVIDIA_ANSWER_MAX_TOKENS=1000
# MiniMax direct reste disponible si le compte possède des crédits.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_REQUEST_TIMEOUT_SECONDS=60
MINIMAX_CLASSIFICATION_MAX_TOKENS=600
MINIMAX_ANSWER_MAX_TOKENS=1000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=60
OLLAMA_CLASSIFICATION_MAX_TOKENS=600
OLLAMA_ANSWER_MAX_TOKENS=1000
OLLAMA_HOST_PORT=11434
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_HOST_PORT=8001
# Mémoire conversationnelle volatile du service IA (RAM uniquement).
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_TURNS=10
CONVERSATION_MAX_SESSIONS=1000

# Public browser communication
AI_SERVICE_PUBLIC_URL=http://localhost:8001
# Origines HTTP explicites, séparées par des virgules, sans chemin.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Internal API authentication
# Doit contenir au minimum 32 caractères.
# Génération conseillée :
# python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=replace_with_a_random_internal_api_key

# Initial data
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_a_secure_password
SEED_BRANCH_1_NAME=Toulouse
SEED_BRANCH_2_NAME=Carcassonne
