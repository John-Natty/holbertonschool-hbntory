# PostgreSQL
POSTGRES_DB=hbntory
POSTGRES_USER=hbntory_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5432

# Backoffice
DATABASE_URL=postgresql://hbntory_user:your_database_password@database:5432/hbntory

# Doit contenir au minimum 32 caractères.
# Génération conseillée :
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_32_CHARACTERS_MINIMUM

SESSION_COOKIE_SECURE=false

# PostgreSQL utilisé uniquement par les tests.
# Cette base doit être séparée de la base de développement.
# Utiliser localhost lorsque les tests sont lancés depuis WSL.
TEST_DATABASE_URL=postgresql://hbntory_user:your_database_password@localhost:5432/hbntory_test

# External Product API
PRODUCT_API_BASE_URL=http://external-products-api:5000
PRODUCT_API_PORT=5001

# Internal service communication
BACKOFFICE_INTERNAL_URL=http://backoffice:5000
MCP_SERVER_URL=http://product-mcp-server:8000/mcp
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_MAX_CONCURRENT_CALLS=10
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# Public browser communication
AI_SERVICE_PUBLIC_URL=http://localhost:8001

# Internal API authentication
INTERNAL_API_KEY=your_private_internal_api_key

# Initial data
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_a_secure_password
SEED_BRANCH_1_NAME=Toulouse
SEED_BRANCH_2_NAME=Carcassonne
